<?xml version="1.0" encoding="utf-8"?>
<!--
  Project-scoped NuGet config: ignore any user/machine NuGet sources and
  resolve packages exclusively from nuget.org. Keeps publishes / CI runs
  reproducible regardless of the developer's global configuration.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
